# ==============================================================================
# DeskFlow - Configuração de Ambiente para Produção / Deploy
# ==============================================================================

# --- BANCO DE DADOS (PostgreSQL) ---
POSTGRES_DB=deskflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui
DATABASE_URL=postgresql+asyncpg://postgres:defina_uma_senha_forte_aqui@localhost:5432/deskflow

# --- SEGURANÇA E AUTENTICAÇÃO ---
# Chave secreta para assinatura dos tokens JWT (gere uma string aleatória forte)
JWT_SECRET=defina_um_jwt_secret_aleatorio_e_seguro_com_ao_menos_32_caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Token para webhook de integração de ponto biométrico
ATTENDANCE_INTEGRATION_TOKEN=defina_um_token_de_integracao_seguro

# Administrador inicial padrão (gerado no primeiro bootstrap)
DEFAULT_ADMIN_EMAIL=admin@deskflow.com
DEFAULT_ADMIN_PASSWORD=defina_uma_senha_forte_para_o_admin

# --- FUSO HORÁRIO CORPORATIVO ---
OFFICE_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# --- CORS (Origens permitidas para a API) ---
# Em produção, liste os domínios reais separados por vírgula (ex: https://deskflow.seu-dominio.com)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- URL DO BACKEND ACESSÍVEL PELO FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- SEED DE DADOS DE DEMONSTRAÇÃO (Opcional - deixe false em produção) ---
# Se true, injeta reservas e feriados de teste. Se false, inicializa apenas a estrutura limpa.
SEED_DEMO_DATA=false
