# Banco de Dados PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:replace-me@db:5432/deskflow
POSTGRES_PASSWORD=replace-me

# Autenticação e Segurança (chave JWT com no mínimo 32 bytes)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Integração de Ponto Eletrônico (Token para /api/v1/integrations/attendance/sync)
ATTENDANCE_INTEGRATION_TOKEN=replace-with-integration-secret-token

# pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@deskflow.com
PGADMIN_DEFAULT_PASSWORD=replace-with-pgadmin-password

# Banco de Dados de Testes de Integração (opcional para rodar contra PostgreSQL local)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:replace-me@localhost:5432/deskflow

